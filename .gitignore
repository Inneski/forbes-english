# Side projects living in this folder but not part of the deployed site
Twin Peaks/
stranger things/

# Dependencies
node_modules/

# OS/editor cruft
.DS_Store
Thumbs.db

# Python build artefacts from the lesson-template scripts
__pycache__/
*.pyc

# Per-lesson delivery artefacts, regenerated from the lesson on demand.
# HOUSE-STYLE §11a: the self-contained preview is what gets SENT with a
# build — every image inlined as a data: URI so it opens standalone — which
# makes it a multi-megabyte near-duplicate of a file already tracked here.
# The PDF is a print export of the same deck. Neither belongs on origin/main.
# (Worksheets and source PDFs that live in lesson folders are unaffected.)
*-PREVIEW.html
/forbes-risk-management-c1-c2.pdf

# Hash cache for tools/prep-artwork.py — machine-local, rebuilt on demand
tools/.artwork-hashes.json

# Drop folder for /publish. Raw Midjourney PNGs and unbuilt HTML land here
# and must never reach git — .git is ~700 MB with no LFS and never forgets
# a blob. Only the README is tracked.
incoming/*
!incoming/README.md

# Scratch files. A leading underscore means "mine, this session" — smoke
# tests, probes, one-off audit scripts. check-library.js skips them too.
_*
lesson-template/build/.stage/
