{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.js\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "git-guard: checking for shared-tree hazards"
          }
        ]
      }
    ]
  }
}
